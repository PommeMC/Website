---
import "@/styles/compare.css";
import { Image } from "astro:assets";
import { compareValueText } from "@/utils/compare";

interface Side {
  /** An imported image, or the URL of one that is already optimised (then `size` is required). */
  src: ImageMetadata | string;
  label: string;
  alt: string;
}
interface Props {
  before: Side;
  after: Side;
  /** How wide the slider renders, for picking image sizes. */
  sizes?: string;
  /** Pixel size of URL images, so the page doesn't shift while they load. */
  size?: { width: number; height: number };
}
const { before, after, sizes = "(max-width: 1120px) 100vw, 1088px", size } = Astro.props;
const widths = [640, 1120, 1600, 2240];
---

<div class="cmp" data-compare data-before={before.label} data-after={after.label}>
  {
    [before, after].map((side, i) => {
      const imgClass = ["cmp-img", { "cmp-top": i > 0 }];
      return (
        <Fragment>
          {typeof side.src === "string" ? (
            <img
              src={side.src}
              alt={side.alt}
              width={size?.width}
              height={size?.height}
              loading="lazy"
              decoding="async"
              class:list={imgClass}
            />
          ) : (
            <Image src={side.src} alt={side.alt} widths={widths} sizes={sizes} format="webp" class:list={imgClass} />
          )}
          <span class:list={["home-d cmp-tag", { "cmp-tag-end": i > 0 }]}>{side.label}</span>
        </Fragment>
      );
    })
  }
  <slot />
  <span class="cmp-handle" aria-hidden="true">
    <span class="cmp-grip">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M9 6l-6 6 6 6zM15 6l6 6-6 6z"></path>
      </svg>
    </span>
  </span>
  <input
    type="range"
    min="0"
    max="100"
    value="50"
    aria-label={`Compare ${before.label} and ${after.label}`}
    aria-valuetext={compareValueText(50, before.label, after.label)}
  />
</div>

<script>
  import { compareValueText } from "@/utils/compare";

  for (const box of document.querySelectorAll<HTMLElement>("[data-compare]")) {
    const input = box.querySelector("input");
    if (!input) continue;
    const { before = "", after = "" } = box.dataset;
    const set = (pos: number) => {
      const v = Math.round(Math.min(100, Math.max(0, pos)));
      input.value = String(v);
      input.setAttribute("aria-valuetext", compareValueText(v, before, after));
      box.style.setProperty("--split", `${v}%`);
    };
    const fromPointer = (e: PointerEvent) => {
      const r = box.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };

    input.addEventListener("input", () => set(Number(input.value)));
    // Dragging is handled on the whole frame rather than the range thumb, which iOS only lets you grab directly.
    box.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      box.setPointerCapture(e.pointerId);
      fromPointer(e);
      input.focus({ preventScroll: true });
    });
    box.addEventListener("pointermove", (e) => {
      if (box.hasPointerCapture(e.pointerId)) fromPointer(e);
    });
  }
</script>
