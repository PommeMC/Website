---
import "@/styles/footer.css";
import { Icon } from "astro-icon/components";
import SiteBrand from "@/components/layout/SiteBrand.astro";
import { LINKS } from "@/data/home";
import { DISCLAIMER, LICENCE } from "@/data/layout";
import { NEW_TAB, externalAttrs, getNavLinks, getSitePages } from "@/data/nav";

const hash = import.meta.env.GIT_COMMIT_HASH;
const year = new Date().getFullYear();
const [{ social }, pages] = await Promise.all([getNavLinks(), getSitePages()]);
---

<footer class="site-footer">
  <div class="home-w">
    <div class="site-footer-top">
      <SiteBrand />
      <nav aria-label="Footer">
        <ul class="site-footer-links" role="list">
          {
            pages.map((l) => (
              <li>
                <a class="site-nl" href={l.href} {...externalAttrs(l)}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="site-footer-social" role="list">
        {
          social.map((l) => (
            <li>
              <a class="site-nl" href={l.href} aria-label={l.label} {...externalAttrs(l)}>
                <Icon name={`icons/fontawesome/${l.icon}`} aria-hidden="true" class="site-icon" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="site-footer-bottom">
      <p class="site-footer-legal">{DISCLAIMER}</p>
      <p>
        &copy; {year} Pomme · {LICENCE} · <a class="home-quiet-link" href={LINKS.sponsor} {...NEW_TAB}>Donate</a>
        {
          hash && (
            <>
              {" · "}
              <a class="home-quiet-link" href={`https://github.com/PommeMC/Website/commit/${hash}`} aria-label={`Site version ${hash}`}>
                {hash}
              </a>
            </>
          )
        }
      </p>
    </div>
  </div>
</footer>
