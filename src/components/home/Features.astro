---
import { FEATURES } from "@/data/home";
---

<section class="home-alt">
  <div class="home-w home-s">
    <h2 class="home-d home-h2 home-features-title">
      Not a mod. Not a launcher. <span class="home-sun">The whole client, rebuilt.</span>
    </h2>
    <ul class="home-three" role="list">
      {
        FEATURES.map((f) => (
          <li class="home-feature">
            <h3 class="home-d">{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
