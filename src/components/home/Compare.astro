---
import { Image } from "astro:assets";
import { COMPARE, compareValueText } from "@/data/compare";

const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/compare/*.png", { eager: true });
const keys = ["vanilla", "pomme"] as const;
const sides = keys.flatMap((key) => {
  const src = files[`/src/assets/compare/${key}.png`]?.default;
  return src ? [{ ...COMPARE[key], src }] : [];
});
const widths = [640, 1120, 1600, 2240];
const sizes = "(max-width: 1120px) 100vw, 1088px";
---

{
  sides.length === keys.length && (
    <section class="home-ruled">
      <div class="home-w home-s">
        <div class="home-stack home-compare-head">
          <h2 class="home-d home-h2">See further</h2>
          <p class="home-muted">{COMPARE.caption}</p>
        </div>

        <div class="home-cmp" data-compare>
          {sides.map((side, i) => (
            <Fragment>
              <Image
                src={side.src}
                alt={side.alt}
                widths={widths}
                sizes={sizes}
                format="webp"
                class:list={["home-cmp-img", { "home-cmp-top": i > 0 }]}
              />
              <span class:list={["home-d home-cmp-tag", { "home-cmp-tag-end": i > 0 }]}>{side.label}</span>
            </Fragment>
          ))}
          <span class="home-cmp-handle" aria-hidden="true">
            <span class="home-cmp-grip">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 6l-6 6 6 6zM15 6l6 6-6 6z" />
              </svg>
            </span>
          </span>
          <input
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label={`Compare ${COMPARE.vanilla.label} and ${COMPARE.pomme.label}`}
            aria-valuetext={compareValueText(50)}
          />
        </div>
      </div>
    </section>
  )
}

<script>
  import { compareValueText } from "@/data/compare";

  for (const box of document.querySelectorAll<HTMLElement>("[data-compare]")) {
    const input = box.querySelector("input");
    if (!input) continue;
    const set = (pos: number) => {
      const v = Math.round(Math.min(100, Math.max(0, pos)));
      input.value = String(v);
      input.setAttribute("aria-valuetext", compareValueText(v));
      box.style.setProperty("--split", `${v}%`);
    };
    const fromPointer = (e: PointerEvent) => {
      const r = box.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };

    input.addEventListener("input", () => set(Number(input.value)));
    // Dragging is handled on the whole frame rather than the range thumb, which iOS only lets you grab directly.
    box.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      box.setPointerCapture(e.pointerId);
      fromPointer(e);
      input.focus({ preventScroll: true });
    });
    box.addEventListener("pointermove", (e) => {
      if (box.hasPointerCapture(e.pointerId)) fromPointer(e);
    });
  }
</script>
