---
import "@/styles/home.css";

import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/home/Hero.astro";
import Intro from "@/components/home/Intro.astro";
import Compare from "@/components/home/Compare.astro";
import Demo from "@/components/home/Demo.astro";
import Parity from "@/components/home/Parity.astro";
import Community from "@/components/home/Community.astro";
import Download from "@/components/home/Download.astro";
import { DEMO } from "@/data/home";
import { buildPlatforms } from "@/utils/downloads";
import { getPosts } from "@/utils/news";
import { getParityRun } from "@/utils/parity";
import { getCommitCount, getContributors, getLatestRelease, getStars } from "@/utils/github";
import { getHeroPreloads, HERO_IMAGE, HERO_MOBILE_HEIGHT } from "@/utils/hero";

const [release, contributors, commits, stars, preload, parity, allPosts] = await Promise.all([
  getLatestRelease(),
  getContributors(),
  getCommitCount(),
  getStars(),
  getHeroPreloads(),
  getParityRun(),
  getPosts(),
]);

const platforms = buildPlatforms(release);
const posts = allPosts.slice(0, 3);
---

<Layout
  description="Pomme is a free, high-performance Minecraft: Java Edition client written in Rust. No Java to install, a Vulkan renderer, and gameplay built to match vanilla."
  keywords={["pomme", "minecraft", "client", "rust", "vulkan", "open source"]}
  canonical="/"
  chrome={false}
  navOverlay
>
  <Fragment slot="head">
    {
      preload.map((l) => (
        <link
          rel="preload"
          as="image"
          type="image/webp"
          href={l.src}
          imagesrcset={l.srcset}
          imagesizes={HERO_IMAGE.sizes}
          fetchpriority="high"
        />
      ))
    }
  </Fragment>

  <div class="home" style={`--hero-mobile-h: ${HERO_MOBILE_HEIGHT}px`}>
    <main id="main">
      <Hero />
      <Intro platforms={platforms} release={release} />
      <Compare />
      {DEMO.enabled && <Demo />}
      {parity && <Parity run={parity} />}
      <Community contributors={contributors} commits={commits} stars={stars} posts={posts} alt={parity === null} />
      <Download platforms={platforms} release={release} ruled={parity !== null} />
    </main>
  </div>
</Layout>
