---
import "@/styles/home.css";

import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/home/Hero.astro";
import Intro from "@/components/home/Intro.astro";
import Compare from "@/components/home/Compare.astro";
import Demo from "@/components/home/Demo.astro";
import Parity from "@/components/home/Parity.astro";
import Community from "@/components/home/Community.astro";
import Download from "@/components/home/Download.astro";
import { DEMO, getParity } from "@/data/home";
import { buildPlatforms } from "@/utils/downloads";
import { getCommitCount, getContributors, getLatestRelease, getStars } from "@/utils/github";
import { getHeroLayers, HERO_MOBILE_HEIGHT, HERO_SIZES } from "@/utils/hero";

const [release, contributors, commits, stars, layers] = await Promise.all([
  getLatestRelease(),
  getContributors(),
  getCommitCount(),
  getStars(),
  getHeroLayers(),
]);

const platforms = buildPlatforms(release);
const parity = getParity();
const posts = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const preload = layers.filter((l) => l.priority);
---

<Layout
  title="Home"
  description="Pomme is an open-source Minecraft: Java Edition client written in Rust, with a Vulkan renderer."
  keywords={["pomme", "minecraft", "client", "rust", "vulkan", "open source"]}
  canonical="/"
  chrome={false}
  navOverlay
>
  <Fragment slot="head">
    {
      preload.map((l) => (
        <link rel="preload" as="image" type="image/webp" href={l.src} imagesrcset={l.srcset} imagesizes={HERO_SIZES} fetchpriority="high" />
      ))
    }
  </Fragment>

  <div class="home" style={`--hero-mobile-h: ${HERO_MOBILE_HEIGHT}px`}>
    <main id="main">
      <Hero />
      <Intro platforms={platforms} release={release} />
      <Compare />
      {DEMO.enabled && <Demo />}
      {parity && <Parity parity={parity} />}
      <Community contributors={contributors} commits={commits} stars={stars} posts={posts} alt={parity === null} />
      <Download platforms={platforms} release={release} ruled={parity !== null} />
    </main>
  </div>
</Layout>
