---
import "@/styles/post.css";
import { getImage, Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import CompareSlider from "@/components/CompareSlider.astro";
import LongDate from "@/components/LongDate.astro";
import NewsTag from "@/components/news/NewsTag.astro";
import PostCover from "@/components/news/PostCover.astro";
import JsonScript from "@/components/JsonScript.astro";
import Layout from "@/layouts/Layout.astro";
import { PAGE_TITLE_ID, SITE_CARD } from "@/data/layout";
import { DEFAULT_AUTHOR } from "@/data/posts";
import { DOWNLOADS_HREF } from "@/data/nav";
import { listFormat } from "@/utils/content";
import { buildPlatforms, downloadableSystems } from "@/utils/downloads";
import { getLatestRelease, loginAvatar } from "@/utils/github";
import { getPosts, postInfo } from "@/utils/news";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
  newer?: CollectionEntry<"posts">;
  older?: CollectionEntry<"posts">;
}
const { post, newer, older } = Astro.props;
const { data } = post;
const { Content } = await render(post);
/** Components a post can use without importing them. */
const components = { CompareSlider };
const { title, summary, readTime } = postInfo(post);
const BYLINE_AVATAR = 40;
const THANKS_AVATAR = 36;

// A local cover is shared as a JPEG at link-preview width, since not every site that shows previews reads WebP.
const cover = data.cover;
const share = !cover
  ? SITE_CARD
  : typeof cover.src === "string"
    ? { src: cover.src, alt: cover.alt }
    : await getImage({ src: cover.src, width: 1200, format: "jpg" }).then((img) => ({
        src: img.src,
        width: Number(img.attributes.width),
        height: Number(img.attributes.height),
        alt: cover.alt,
      }));

const release = await getLatestRelease();
const systems = listFormat.format(downloadableSystems(buildPlatforms(release)));

const canonical = `/news/${post.id}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: summary,
  datePublished: data.date.toISOString(),
  author: { "@type": data.author === DEFAULT_AUTHOR ? "Organization" : "Person", name: data.author },
  image: new URL(share.src, Astro.site),
  url: new URL(canonical, Astro.site),
  publisher: { "@type": "Organization", name: "Pomme", url: Astro.site },
};
---

<Layout {title} description={summary} {canonical} {share}>
  <Fragment slot="head">
    <JsonScript type="application/ld+json" data={structuredData} />
  </Fragment>
  <div class="home">
    <article class="home-s post">
      <header class="post-col post-head">
        <a class="home-link post-back" href="/news">← All news</a>
        <NewsTag category={data.category} />
        <h1 id={PAGE_TITLE_ID} class="home-d post-title">{title}</h1>
        {data.description && <p class="post-summary">{data.description}</p>}
        <p class="post-byline">
          <Image
            src={data.github ? loginAvatar(data.github, BYLINE_AVATAR) : data.authorAvatar}
            width={BYLINE_AVATAR}
            height={BYLINE_AVATAR}
            layout="fixed"
            alt=""
            loading="eager"
          />
          <span>
            <strong>{data.author}</strong>
            <span class="home-small">
              <LongDate date={data.date} /> · {readTime}
            </span>
          </span>
        </p>
      </header>

      {
        data.cover && (
          <figure class="post-wide">
            <PostCover cover={data.cover} widths={[640, 960, 1440, 1920]} sizes="(max-width: 1000px) 100vw, 960px" />
            {data.cover.caption && <figcaption class="home-small">{data.cover.caption}</figcaption>}
          </figure>
        )
      }

      <div class="post-body">
        <Content components={components} />
      </div>

      <footer class="post-col post-end">
        {
          data.thanks && data.thanks.length > 0 && (
            <p class="home-small post-thanks">
              <span class="post-thanks-faces" aria-hidden="true">
                {data.thanks.map((login) => (
                  <Image src={loginAvatar(login, THANKS_AVATAR)} width={THANKS_AVATAR} height={THANKS_AVATAR} layout="fixed" alt="" />
                ))}
              </span>
              <span>
                Thanks to{" "}
                {listFormat.formatToParts(data.thanks).map((part) =>
                  part.type === "element" ? (
                    <a class="home-quiet-link" href={`https://github.com/${part.value}`}>
                      {part.value}
                    </a>
                  ) : (
                    part.value
                  )
                )}{" "}
                for their work on this.
              </span>
            </p>
          )
        }

        <div class="post-get">
          <div>
            <p class="home-d post-get-title">{release ? `Get v${release.version}` : "Get Pomme"}</p>
            <p>{systems ? `${systems}. ` : ""}Already on Pomme? It updates itself.</p>
          </div>
          <a class="home-d post-get-button" href={DOWNLOADS_HREF}>Download</a>
        </div>

        <nav class="post-nav" aria-label="More news">
          {
            older && (
              <a href={`/news/${older.id}`}>
                <span class="home-small">← Older</span>
                <span class="home-d">{postInfo(older).title}</span>
              </a>
            )
          }
          <a href={newer ? `/news/${newer.id}` : "/news"} class="post-nav-next">
            <span class="home-small">{newer ? "Newer →" : "Newest post"}</span>
            <span class="home-d">{newer ? postInfo(newer).title : "Back to all news →"}</span>
          </a>
        </nav>
      </footer>
    </article>
  </div>
</Layout>
