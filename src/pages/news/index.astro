---
import "@/styles/news.css";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import LongDate from "@/components/LongDate.astro";
import NewsTag from "@/components/news/NewsTag.astro";
import { LINKS } from "@/data/home";
import { NEW_TAB, externalAttrs } from "@/data/nav";
import { getNewsEntries, NEWS_CATEGORIES } from "@/utils/news";

const entries = await getNewsEntries();
const [featured] = entries;
const categories = [...new Set(entries.map((e) => e.category))];
---

<Layout
  title="News"
  description="Releases and posts from the Pomme team."
  keywords={["pomme", "news", "releases", "changelog"]}
  canonical="/news"
>
  <div class="home">
    <div class="home-w home-s">
      <header class="news-head">
        <div class="home-stack">
          <h1 class="home-d news-h1">News</h1>
          <p class="home-muted">Releases and posts from the Pomme team.</p>
        </div>
        {
          categories.length > 1 && (
            <div class="news-tabs" role="group" aria-label="Show" data-news-tabs>
              <button type="button" class="home-d" aria-pressed="true" data-filter="all">
                All
              </button>
              {categories.map((c) => (
                <button type="button" class="home-d" aria-pressed="false" data-filter={c}>
                  {NEWS_CATEGORIES[c].tab}
                </button>
              ))}
            </div>
          )
        }
      </header>

      {
        featured ? (
          <Fragment>
            <article class:list={["news-featured", { "news-featured-cover": featured.cover }]} data-news-featured>
              {featured.cover && (
                <Image
                  src={featured.cover.src}
                  alt={featured.cover.alt ?? ""}
                  inferSize
                  widths={[640, 1120]}
                  sizes="(max-width: 900px) 100vw, 560px"
                  loading="eager"
                />
              )}
              <div class="home-stack news-featured-body">
                <p class="home-small news-meta">
                  <NewsTag category={featured.category} />
                  <LongDate date={featured.date} />
                  {featured.meta && <span>· {featured.meta}</span>}
                </p>
                <h2 class="home-d news-featured-title">{featured.title}</h2>
                {featured.summary && <p>{featured.summary}</p>}
                {featured.changes && featured.changes.shown.length > 0 && (
                  <ul class="news-changes">
                    {featured.changes.shown.map((c) => (
                      <li>{c}</li>
                    ))}
                    {featured.changes.more > 0 && <li class="news-changes-more">and {featured.changes.more} more</li>}
                  </ul>
                )}
                <a class="home-link" href={featured.href} {...externalAttrs(featured)}>
                  {featured.cta} →
                </a>
              </div>
            </article>

            <h2 class="home-sr">All news</h2>
            <ul class="news-list" role="list" data-news-list>
              {entries.map((e) => (
                <li class="news-row" data-category={e.category} hidden={e === featured}>
                  <span class="home-small">
                    <LongDate date={e.date} />
                  </span>
                  <NewsTag category={e.category} />
                  <div class="news-row-text">
                    <h3 class="home-d">
                      <a href={e.href} {...externalAttrs(e)}>
                        {e.title}
                      </a>
                    </h3>
                    {e.summary && <p>{e.summary}</p>}
                  </div>
                  {e.meta && <span class="home-small news-row-meta">{e.meta}</span>}
                </li>
              ))}
            </ul>
          </Fragment>
        ) : (
          <p class="home-muted news-empty">Nothing here yet.</p>
        )
      }

      <aside class="news-follow" aria-label="Follow Pomme">
        <div>
          <p class="home-d news-follow-title">Don't miss the next release</p>
          <p class="home-muted">Follow along on Discord, or subscribe to the RSS feed.</p>
        </div>
        <div class="news-follow-links">
          <a class="home-rib home-rib-sm" href={LINKS.discord} {...NEW_TAB}>Join the Discord</a>
          <a class="home-d news-rss" href="/news/rss.xml">RSS feed</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const tabs = document.querySelector("[data-news-tabs]");
  const list = document.querySelector<HTMLElement>("[data-news-list]");
  const featured = document.querySelector<HTMLElement>("[data-news-featured]");
  tabs?.addEventListener("click", (e) => {
    const button = (e.target as Element).closest<HTMLButtonElement>("button[data-filter]");
    if (!button || !list) return;
    const filter = button.dataset.filter ?? "all";
    for (const b of tabs.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b === button));
    // The unfiltered page leads with the featured panel; a filtered one lists every match instead.
    if (featured) featured.hidden = filter !== "all";
    for (const row of list.children as HTMLCollectionOf<HTMLElement>) {
      row.hidden = filter === "all" ? row === list.firstElementChild : row.dataset.category !== filter;
    }
  });
</script>
