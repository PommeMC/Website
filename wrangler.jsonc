{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pomme-website",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  // Only pomme.rs serves the site, and nothing uploads preview versions.
  "workers_dev": false,
  "preview_urls": false,
}
