---
import Footer from "@/components/layout/Footer.astro";
import SiteNav from "@/components/layout/SiteNav.astro";
import { NAV_HEIGHT } from "@/data/layout";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  keywords: string[];
  canonical: string;
  /** Set to false on pages that render their own footer and main landmark. */
  chrome?: boolean;
  /** Nav starts clear over a full-bleed hero and turns solid on scroll. */
  navOverlay?: boolean;
}

const { title, description, keywords, canonical, chrome = true, navOverlay = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark bg-background-dark-90 scroll-smooth text-white [tap-highlight-color:transparent]" style="color-scheme: dark;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/logo/256x.png" />
    <meta property="og:url" content={`https://pomme.rs` + canonical} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Pomme" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/logo/256x.png" />
    <link rel="canonical" href={`https://pomme.rs` + canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{`${title} | Pomme`}</title>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col" style={`--nav-h: ${NAV_HEIGHT}px`}>
    {
      chrome && (
        <div class="bg-primary-400/10 border-primary-400/20 text-primary-400 border-b px-6 py-2 text-center text-xs">
          This website is currently in preview. Things may change.
        </div>
      )
    }
    <SiteNav overlay={navOverlay} />
    {
      chrome ? (
        <main class="flex-1" id="main">
          <slot />
        </main>
      ) : (
        <slot />
      )
    }
    {chrome && <Footer />}
  </body>
</html>
