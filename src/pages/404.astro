---
import { Image } from "astro:assets";
import core from "@/assets/brand/apple-core.png";
import Layout from "@/layouts/Layout.astro";
import { NEW_TAB, externalAttrs, getSitePages } from "@/data/nav";
import { NEW_ISSUE_URL } from "@/utils/github";

const pages = await getSitePages();
---

<Layout title="Page not found" description="This page doesn't exist." canonical="/404">
  <div class="home">
    <div class="home-w home-s missing">
      <Image src={core} alt="An eaten apple core" widths={[180, 379]} sizes="180px" loading="eager" />
      <div class="home-stack">
        <p class="home-d missing-kicker">Error 404</p>
        <h1 class="home-d missing-title">Someone already ate this page.</h1>
        <p class="home-muted">The link may be old, or the page may have moved. Nothing is wrong on your end.</p>
        <a class="home-rib" href="/">Back to the homepage</a>
        <nav class="missing-links" aria-label="Pages">
          {
            pages.map((l) => (
              <a class="home-link" href={l.href} {...externalAttrs(l)}>
                {l.label}
              </a>
            ))
          }
        </nav>
        <p class="home-small">
          Followed a link from our site to get here? <a class="home-inline-link" href={NEW_ISSUE_URL} {...NEW_TAB}>Tell us on GitHub</a> so we
          can fix it.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .missing {
    display: grid;
    grid-template-columns: 180px minmax(0, 520px);
    justify-content: center;
    align-items: center;
    gap: 64px;
    min-height: 60vh;
  }
  .missing :global(img) {
    width: 180px;
    height: auto;
  }
  .missing-kicker {
    font-size: 16px;
    letter-spacing: 0.3em;
    color: var(--sun);
  }
  .missing-title {
    font-size: 52px;
  }
  .missing-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
  }

  /* Keep in sync with MOBILE_BREAKPOINT in src/data/layout.ts. */
  @media (max-width: 900px) {
    .missing {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      min-height: 0;
    }
    .missing :global(img) {
      width: 120px;
    }
    .missing-title {
      font-size: 36px;
    }
  }
</style>
