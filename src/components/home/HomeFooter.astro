---
import { LINKS } from "@/data/home";
import { GITHUB_URL } from "@/utils/github";

interface Props {
  parityUrl: string | null;
}
const { parityUrl } = Astro.props;
const year = new Date().getFullYear();

const links = [
  parityUrl && { label: "Parity tracker", href: parityUrl },
  { label: "News", href: "/news" },
  { label: "Docs", href: LINKS.docs },
  { label: "Changelog", href: LINKS.releases },
  { label: "Discord", href: LINKS.discord },
  { label: "GitHub", href: GITHUB_URL },
  { label: "Contribute", href: LINKS.contribute },
  { label: "Donate", href: "/donate" },
].filter((l): l is { label: string; href: string } => Boolean(l));
---

<footer class="home-footer">
  <div class="home-w home-footer-in">
    <p class="home-footer-legal">Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.</p>
    <nav aria-label="Footer">
      <ul role="list" class="home-footer-links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="home-footer-copy">&copy; {year} Pomme contributors · GPL-3.0</p>
  </div>
</footer>
